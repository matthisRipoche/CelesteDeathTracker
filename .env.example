# Copier en .env (ignoré par git) et adapter. Ne jamais committer .env.
POSTGRES_PASSWORD=change-me
# Port du site (nginx). Défaut : 8080 (8090 ici car 8080-8081 souvent pris en local)
WEB_PORT=8090

# Adresse publique du site (ouverte par le mod pour associer un jeu)
PUBLIC_URL=http://localhost:8090

# Connexion Discord (facultatif) : portail développeur Discord > OAuth2.
# Adresse de retour à déclarer chez Discord : <adresse du site>/api/auth/oauth2/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
